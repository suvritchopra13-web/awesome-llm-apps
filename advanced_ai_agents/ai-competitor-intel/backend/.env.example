# Backend Environment Variables

# Required API Keys (Always needed)
OPENAI_API_KEY=sk-your-openai-key-here
FIRECRAWL_API_KEY=your-firecrawl-key-here

# ===== SEARCH ENGINE OPTIONS (Choose ONE) =====

# Option 1: DuckDuckGo (🆓 100% FREE - NO API KEY NEEDED!)
# Just use the dropdown in Streamlit - no setup required!

# Option 2: Tavily AI (⭐ RECOMMENDED - Free tier: 1000 searches/month)
# Sign up at https://tavily.com for free API key
TAVILY_API_KEY=your-tavily-key-here

# Option 3: Perplexity (Paid only)
# PERPLEXITY_API_KEY=your-perplexity-key-here

# Option 4: Exa AI (Paid only)
# EXA_API_KEY=your-exa-key-here

# Server Configuration
PORT=8000
HOST=0.0.0.0
